# --- LiveKit --- You will receive this from the BCG team
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=...
LIVEKIT_API_SECRET=...

# --- Voice stack --- You will receive this from the BCG team
# OpenAI Realtime API handles STT + LLM + TTS in one stream.
OPENAI_API_KEY=sk-...

# --- MCP server --- The agent connects to the MCP server (src/cars_mcp);
# this default matches `uv run used-car-advisor-mcp`.
MCP_URL=http://127.0.0.1:8990/mcp

# --- Email --- You will receive this from the BCG team
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=eu-central-1
EMAIL_RECIPIENT=your_email_address

# --- Extras --- You will receive this from the BCG team
TAVUS_API_KEY=

# --- Avatar (cherry on top) ---
# 1 gives the advisor a Tavus face; it publishes the lip-synced audio, so the
# agent stops publishing its own. Failure is caught and the session continues
# audio-only. Leave the ids empty to use the stock replica "Charlie".
USE_AVATAR=0
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=

# --- Demo fixture ---
# 1 plants one listing (ref 00000000) whose description attacks the model, so
# the prompt-injection defence can be shown live. See docs/SECURITY.md.
DEMO_INJECTION=0
